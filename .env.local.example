NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-only: push naar andere users + cron reminders + admin-API (RLS-bypass).
# Lokaal: zet de service role key uit Supabase → Project Settings → API, anders falen o.a. writes op task_type_point_rules.
SUPABASE_SERVICE_ROLE_KEY=

# --- Prisma + Supabase Postgres ---
# Kopieer deze regels naar `.env.local` en vul [YOUR-PASSWORD] en je project-ref in
# (Supabase → Project Settings → Database → Connection string).

# Pooling (PgBouncer) — geschikt voor Prisma Client / runtime queries
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Directe verbinding — gebruikt door Prisma voor migraties (`directUrl` in schema.prisma)
# DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Alternatief: alleen voor handmatige SQL-migraties (npm run db:migrate-015) volstaat soms één URI:
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@db.[ref].supabase.co:5432/postgres

# Web Push (genereer met: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optioneel: contact voor VAPID (mailto: of https://)
VAPID_SUBJECT=mailto:you@example.com

# Cron: Authorization: Bearer <CRON_SECRET> op GET/POST /api/cron/reminders en /api/cron/email-reminders
CRON_SECRET=

# E-mail (Resend): toewijzing + 24u-herinnering
RESEND_API_KEY=
# Bijv. "ClubInzet <onboarding@resend.dev>" of je geverifieerde domein
EMAIL_FROM=
# Link in mails (productie-URL)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# POST /api/send-push — productie: altijd true (alleen profiles.role=admin mag naar anderen pushen).
# Zonder deze var of false: elke ingelogde gebruiker kan send-push aanroepen (club-MVP).
PUSH_REQUIRE_ADMIN=true
# Lokaal testen zonder admin in profiles: zet op false of verwijder de regel.
# PUSH_REQUIRE_ADMIN=false
